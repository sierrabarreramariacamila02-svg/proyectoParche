<file path="models/pedido.js">
import supabase from '../config/supabase.js';

export const ESTADOS = ['pendiente', 'en_preparacion', 'listo', 'en_camino', 'entregado', 'cancelado'];

export const crearPedido = async (usuario_id, direccion_entrega, items) => {
  const total = items.reduce((sum, item) => sum + item.cantidad * item.precio_unitario, 0);

  const { data: pedido, error: errorPedido } = await supabase
    .from('pedido')
    .insert([{ usuario_id, direccion_entrega, total, estado: 'pendiente' }])
    .select()
    .single();

  if (errorPedido) throw errorPedido;

  const detalles = items.map((item) => ({ ...item, pedido_id: pedido.id }));

  const { error: errorDetalle } = await supabase.from('detallePedido').insert(detalles);
  if (errorDetalle) throw errorDetalle;

  return pedido;
};

export const obtenerPedidoPorId = async (id) => {
  const { data, error } = await supabase
    .from('pedido')
    .select('*, detallePedido(*, producto(*))')
    .eq('id', id)
